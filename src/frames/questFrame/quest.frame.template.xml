<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
    <Button name="DQuestItemTemplate" virtual="true">
        <Size>
            <AbsDimension x="195" y="40" />
        </Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" file="Interface\AddOns\DialogUIWotLK\src\assets\art\parchment\RewardChoice-Pending">
                    <Size>
                        <AbsDimension x="195" y="40" />
                    </Size>
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="0" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
                <Texture name="$parentNameFrame" file="">
                    <Size>
                        <AbsDimension x="195" y="40" />
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentIconTexture" relativePoint="RIGHT">
                            <Offset>
                                <AbsDimension x="-10" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentIconTexture">
                    <Size>
                        <AbsDimension x="28" y="28" />
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="7" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString name="$parentName" inherits="DGameFontHighlight" justifyH="LEFT">
                    <Size>
                        <AbsDimension x="140" y="36" />
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentBackground">
                            <Offset>
                                <AbsDimension x="40" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="ARTWORK">
                <FontString name="$parentCount" inherits="NumberFontNormal" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentIconTexture">
                            <Offset>
                                <AbsDimension x="-4" y="1" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                this.hasItem = 1;
            </OnLoad>
            <!--<OnEnter>
                if ( this:GetAlpha() > 0 ) then
                GameTooltip:SetOwner(this, "ANCHOR_RIGHT");
                if ( this.rewardType == "item" ) then
                GameTooltip:SetQuestItem(this.type, this:GetID());
                elseif ( this.rewardType == "spell" ) then
                GameTooltip:SetQuestRewardSpell();
                end
                end
                CursorUpdate(this);
            </OnEnter> -->
			<OnEnter>
				local owner = self or this;
				if ( owner and owner ~= GameTooltip and owner:GetAlpha() > 0 ) then
					GameTooltip:SetOwner(owner, "ANCHOR_RIGHT");
					if ( owner.rewardType == "item" ) then
						GameTooltip:SetQuestItem(owner.type, owner:GetID());
					elseif ( owner.rewardType == "spell" ) then
						GameTooltip:SetQuestRewardSpell();
					end
					GameTooltip:Show();
				end
				if ( owner ) then
					CursorUpdate(owner);
				end
			</OnEnter>
            <OnLeave>
                GameTooltip:Hide();
                ResetCursor();
            </OnLeave>
            <OnUpdate>
                CursorOnUpdate(this);
            </OnUpdate>
            <OnClick>
                DQuestItem_OnClick();
            </OnClick>
        </Scripts>
    </Button>
    <Button name="DQuestRewardItemTemplate" inherits="DQuestItemTemplate" virtual="true">
        <Scripts>
            <OnClick>
                DQuestRewardItem_OnClick();
            </OnClick>
        </Scripts>
    </Button>
    <Button name="DQuestTitleButtonTemplate" virtual="true">
        <Size x="400" y="20" />
        <Scripts>
            <OnClick>
				DQuestTitleButton_OnClick();
			</OnClick>
        </Scripts>
		<HighlightTexture
        file="Interface\AddOns\DialogUIWotLK\src\assets\art\parchment\ButtonHighlight-Gossip"
        alphaMode="ADD" />
		<Layers>
            <Layer level="OVERLAY">
                <Texture name="$parentQuestIcon" file="Interface\AddOns\DialogUIWotLK\src\assets\art\icons\availableQuestIcon">
                    <Size>
                        <AbsDimension x="20" y="20" />
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="5" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <ButtonText inherits="DQuestButtonTitleGossip" justifyH="LEFT">
            <Size x="360" y="0" />
            <Anchors>
                <Anchor point="LEFT">
                    <Offset>
                        <!-- controls the text inside of greeting panel  -->
                        <AbsDimension x="30" y="0" />
                    </Offset>
                </Anchor>
            </Anchors>
        </ButtonText>        
    </Button>
</Ui>
